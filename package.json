{
  "name": "eventflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "dev": "npm run dev -w @eventflow/web",
    "build": "npm run build -w @eventflow/web",
    "preview": "npm run preview -w @eventflow/web",
    "desktop": "npm run build && npm run start -w @eventflow/desktop",
    "desktop:dev": "npm run dev -w @eventflow/desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "ws": "^8.22.2"
  }
}
